    "@agentic/logger": "workspace:*",
    "bullmq": "^5.42.0",
    "drizzle-orm": "^0.40.0",
    "ioredis": "5.10.1",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
